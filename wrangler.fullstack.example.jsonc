{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "etf-dashboard",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-21",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "active-etf-db",
    "database_id": "REPLACE_WITH_CLOUDFLARE_D1_ID",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{
    "binding": "RAW_DATA",
    "bucket_name": "active-etf-raw-data"
  }],
  "triggers": {
    "crons": ["30 10 * * 1-5"]
  },
  "vars": {
    "DEPLOYMENT_TARGET": "cloudflare"
  }
}
